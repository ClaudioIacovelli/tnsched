# What goes online is listed here, nothing else: ignore everything, then un-ignore the upload set.
/*
!/.gitignore
!/LICENSE
!/README.md
!/pyproject.toml
!/requirements.txt
!/docs/

!/src/
/src/*
!/src/tnsched/
/src/tnsched/*
!/src/tnsched/__init__.py
!/src/tnsched/benchmark.py
!/src/tnsched/config.py
!/src/tnsched/descriptors.py
!/src/tnsched/features.py
!/src/tnsched/instances.py
!/src/tnsched/suite.py

!/scripts/
/scripts/*
!/scripts/00_get_benchmark.py
!/scripts/01_build_instances.py
!/scripts/02_compute_descriptors.py
!/scripts/03_compute_features.py
!/scripts/_shared.py

!/tests/
/tests/*
!/tests/conftest.py
!/tests/test_benchmark.py
!/tests/test_descriptors.py
!/tests/test_features.py
!/tests/test_instances.py
!/tests/test_scripts.py
!/tests/test_suite.py

!/results/
/results/*
!/results/instances/
/results/instances/*
!/results/instances/reference.jsonl
!/results/instances/reference.meta.json
!/results/instances/classifier.jsonl
!/results/instances/classifier.meta.json
!/results/descriptors/
/results/descriptors/*
!/results/descriptors/reference.jsonl
!/results/descriptors/reference.meta.json
!/results/descriptors/reference_class_table.md
!/results/descriptors/classifier.jsonl
!/results/descriptors/classifier.meta.json
!/results/descriptors/classifier_class_table.md
